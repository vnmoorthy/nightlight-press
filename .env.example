# Nightlight Press: company keys and wiring.
# Copy to .env at the repo root (gitignored) and fill in your own values. Never commit real values.
# app/dev.sh and deploy.sh both read this file. Lines left commented out use the app's defaults.

# ---------- Sponsor keys ----------
# Naïve: the Author, Front Desk, Marketing and Night Manager agents, narration, and deploys.
NAIVE_API_KEY=
# Monid: paintings, Kling films, delivery SMS and the Storyteller Line phone calls.
MONID_API_KEY=
# AgentMail: emails every book and receives family replies (revisions).
AGENTMAIL_API_KEY=
# Mobilerun: the Proofreader opens each finished book on a real phone.
MOBILERUN_API_KEY=
# OpenAI: narration fallback and server-side transcription on /tell.
OPENAI_API_KEY=
# Optional. Without it the Cashier runs in pledge mode (no money taken, never counted as revenue).
# STRIPE_SECRET_KEY=

# ---------- Wiring ----------
# Postgres connection string. Locally it usually lives in app/.env.local instead (see app/.env.example).
# DATABASE_URL=
# Public URL of the app (default http://localhost:3100). Must be https:// for Kling films and self-continuation.
# PUBLIC_BASE_URL=
# AgentMail inbox the Mailroom sends from and the Front Desk reads.
AGENTMAIL_INBOX_ID=
# Ids of the Naïve agents (created by `NL_WITH_APPS=0 ./deploy.sh`; see the README).
NAIVE_AGENT_AUTHOR=
NAIVE_AGENT_FRONTDESK=
NAIVE_AGENT_MARKETER=
# Monid phone number for SMS and the Storyteller Line: its id and its number in E.164 format.
# MONID_NUMBER_ID=
# MONID_FROM_E164=
# Monid voice provider for the Storyteller Line (default: agentline).
# MONID_VOICE_PROVIDER=
# Mobilerun device the Proofreader uses. Without a connected phone, proofs are skipped and logged.
# MOBILERUN_DEVICE_ID=

# ---------- Security ----------
# Admin token for /admin and /api/admin/* (sent as the x-admin-token header). Use a long random string.
# ADMIN_TOKEN=
# On deploy, naive.config.ts hands this to the hosted app as ADMIN_TOKEN.
# NL_ADMIN_TOKEN=
# Svix signing secret for AgentMail's message.received webhook.
# AGENTMAIL_WEBHOOK_SECRET=
# HMAC secret for Naïve's session.idle webhook.
# NAIVE_WEBHOOK_SECRET=

# ---------- Behaviour (optional) ----------
# "classic" turns off the Fernhush Bay world bible.
# WORLD=
# "0" turns off the Film desk (Kling films of the cover and two pages).
# FILM=
# Pages in a book told out loud at /tell (default 8) and in an ordered book (default 10).
# TOLD_PAGES=
# BOOK_PAGES=
# Marketing commissions a free shelf book every N hours (default 12).
# SHELF_EVERY_HOURS=
# "0" stops Marketing from commissioning shelf books on its own.
# AUTO_SHELF=
# "1" lets Marketing post to social media from the Mobilerun phone. Public and permanent, so off by default.
# MOBILERUN_SOCIAL=
# Where the grown-up gated "Meet Pip" link and the book colophon point.
# PLAYROBOT_TOY_URL=
