# Nightlight Press app: local settings.
# Copy to app/.env.local (gitignored). app/dev.sh loads the repo-root .env first, then this file,
# so anything set here wins. Sponsor keys belong in the root .env (see ../.env.example).
# Never commit real values. Lines left commented out use the app's defaults.

# Postgres connection string (required). With the Docker command in the README it is
#   postgres://postgres:postgres@localhost:5432/nightlight
DATABASE_URL=

# Where the app is reachable (default http://localhost:3100).
# PUBLIC_BASE_URL=
# Port for the local server (default 3100).
# PORT=
# Admin token for /admin and /api/admin/* on your local instance (x-admin-token header).
# ADMIN_TOKEN=

# ---------- Local tuning (optional) ----------
# Price in cents (default 1900, i.e. $19).
# PRICE_CENTS=
# Seconds between local clock ticks (default 3).
# TICK_SECONDS=
# "0" turns the local clock off (then only pulses, webhooks and the Night Manager tick the queue).
# ENABLE_INTERNAL_CRON=
# "0" turns off self-continuation (the app calling its own /api/pulse while work is due).
# SELF_PULSE=
# "openai" skips Naïve speech and narrates with OpenAI TTS.
# NARRATION=
# Image quality for paintings (default medium).
# IMAGE_QUALITY=
# The same behaviour switches as the root .env, if you prefer to set them per app.
# WORLD=
# FILM=
# TOLD_PAGES=
# BOOK_PAGES=
# SHELF_EVERY_HOURS=
# AUTO_SHELF=
